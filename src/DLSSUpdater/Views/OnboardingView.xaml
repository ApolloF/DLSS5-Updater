<UserControl x:Class="DLSSUpdater.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DLSSUpdater.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OnboardingViewModel}"
             KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained"
             AutomationProperties.Name="First-run setup">
    <UserControl.Resources>
        <!-- Choice cards: a title and one sentence each, accent border on the picked one; arrow keys move the pick -->
        <DataTemplate x:Key="ChoiceText">
            <StackPanel>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ChoiceList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="ItemTemplate" Value="{StaticResource ChoiceText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Ring" Width="14" Height="14" CornerRadius="7" BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                                                    VerticalAlignment="Top" Margin="0,2,10,0">
                                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{StaticResource Accent}" Visibility="Hidden" />
                                            </Border>
                                            <ContentPresenter Grid.Column="1" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Dims the window behind and takes its clicks; the card stays readable down to the smallest window -->
    <Grid Background="#B3000000">
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="6"
                Width="560" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Margin="24,20,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding StepText}" Style="{StaticResource Caps}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Width="3" Height="16" Background="{StaticResource Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,18" Focusable="False">
                    <Grid>
                        <!-- 1: welcome -->
                        <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" LineHeight="19"
                                       Text="DLSS5 Updater finds your games and installs or updates OptiScaler, DLSS, Streamline, MFG Unlock, ReShade and the NR add-ons in them." />
                            <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
                                       Text="Every file it replaces is backed up first, and Uninstall puts the originals back." />
                            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="12,9" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="nvngx_dlssnr.dll" Style="{StaticResource Mono}" />
                                    <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="The DLSS 5 neural rendering runtime isn't built into the app. It is downloaded and installed automatically; you can import your own copy in Settings → Components → Local components." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 2: install mode -->
                        <StackPanel Visibility="{Binding IsMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="What a new install puts into a game. Each game can still choose its own." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                     AutomationProperties.Name="Default install mode" />
                            <StackPanel Visibility="{Binding IsOptiScalerMode, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <TextBlock Text="OPTISCALER BUILD" Style="{StaticResource Caps}" Margin="0,0,0,8" />
                                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Builds}" SelectedItem="{Binding OptiBuild}"
                                         AutomationProperties.Name="OptiScaler build" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsReShadeMode, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <TextBlock Text="NR ADD-ON" Style="{StaticResource Caps}" Margin="0,0,0,8" />
                                <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Addons}" SelectedItem="{Binding Addon}"
                                         AutomationProperties.Name="NR add-on" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 3: updates and space -->
                        <StackPanel Visibility="{Binding IsUpdates, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DLSS5 UPDATER" Style="{StaticResource Caps}" Margin="0,0,0,4" />
                            <CheckBox Content="Check for updates" IsChecked="{Binding CheckAppUpdates}" Margin="0,6" />
                            <CheckBox IsChecked="{Binding AutoInstallAppUpdates}" Margin="0,6" AutomationProperties.Name="Install updates automatically">
                                <StackPanel>
                                    <TextBlock Text="Install updates automatically" />
                                    <TextBlock Text="Downloads in the background, checks it and installs when DLSS5 Updater closes." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="DOWNLOADS" Style="{StaticResource Caps}" Margin="0,14,0,4" />
                            <CheckBox IsChecked="{Binding AutoDownloadReShade}" Margin="0,6" AutomationProperties.Name="Download ReShade automatically">
                                <StackPanel>
                                    <TextBlock Text="Download ReShade automatically" />
                                    <TextBlock Text="Gets the add-on build from reshade.me when you haven't imported your own ReShade64.dll." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding AutoDownloadLecram}" Margin="0,6" AutomationProperties.Name="Check for new Lecram builds automatically"
                                      Visibility="{Binding ShowLecramChannel, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Check for new Lecram builds automatically" />
                                    <TextBlock Text="Looks at Lecram's public MediaFire channel during update checks and adds new v11 builds to the library." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <TextBlock Text="DISK SPACE" Style="{StaticResource Caps}" Margin="0,14,0,4" />
                            <CheckBox IsChecked="{Binding AutoCleanBuilds}" Margin="0,6" AutomationProperties.Name="Delete old downloads automatically after each download">
                                <StackPanel>
                                    <TextBlock Text="Delete old downloads automatically after each download" TextWrapping="Wrap" />
                                    <TextBlock Text="Imported builds always stay, and so do defaults and builds a game uses." Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="40,6,0,0">
                                <TextBlock Text="Keep newest" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="KeepBox" Width="64" ItemsSource="{Binding KeepChoices}" SelectedItem="{Binding KeepBuilds}"
                                          AutomationProperties.Name="Keep this many newest builds of each library" />
                                <TextBlock Text="builds of each library" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 4: done -->
                        <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" LineHeight="19"
                                       Text="That's it. Pick a game on the left and press Install." />
                            <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
                                       Text="Settings holds the defaults you just chose, the info buttons explain each option, and every game has its own options on its Install and Game config tabs. Settings → App → Run setup again brings this back." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Skip" Style="{StaticResource BtnGhost}" Command="{Binding SkipCommand}"
                            Visibility="{Binding IsLast, Converter={StaticResource InvBoolToVis}}"
                            ToolTip="Close the setup and keep the current settings (Esc)" AutomationProperties.Name="Skip setup" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Back" Style="{StaticResource BtnGhost}" Command="{Binding BackCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
                        <Button x:Name="NextButton" Content="{Binding NextText}" Style="{StaticResource BtnPrimary}" Command="{Binding NextCommand}"
                                ToolTip="Enter" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
