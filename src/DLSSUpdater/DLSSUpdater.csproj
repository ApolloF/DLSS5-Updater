<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DLSS5Updater</AssemblyName>
    <RootNamespace>DLSSUpdater</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>2.2.0</Version>
    <Product>DLSS5 Updater</Product>
    <Company>ApolloF</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- Lecram's builds are paid now, so the public release must not fetch them from his MediaFire channel. The owner's private
       build turns that back on: dotnet publish -p:LecramChannel=true (tools/build-private.ps1). Public releases keep it false. -->
  <PropertyGroup>
    <LecramChannel Condition="'$(LecramChannel)' == ''">false</LecramChannel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LecramChannel)' == 'true'">
    <DefineConstants>$(DefineConstants);LECRAM_CHANNEL</DefineConstants>
    <InformationalVersion>$(Version)+private</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DLSSUpdater.Tests" />
  </ItemGroup>

</Project>
