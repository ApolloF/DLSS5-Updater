<Window x:Class="DLSSUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DLSSUpdater.ViewModels"
        xmlns:core="clr-namespace:DLSSUpdater.Core"
        xmlns:v="clr-namespace:DLSSUpdater.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DLSS5 Updater" Width="1240" Height="800" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Icon="Assets/icon.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Component chip in the header strip -->
        <Style x:Key="ChipValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Strip cell without release notes; same box as a ReleaseChip so the texts line up -->
        <Style x:Key="StripCell" TargetType="Border">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,12,2" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Caps}">
            <Setter Property="Margin" Value="0,28,0,10" />
        </Style>

        <!-- What's new popover of a component chip -->
        <DataTemplate x:Key="ReleaseCard" DataType="{x:Type vm:ReleaseNewsViewModel}">
            <Border Width="380" Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="4" Padding="18,14,18,8" Margin="0,0,14,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="WHAT'S NEW" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource Accent}" Background="{StaticResource AccentSoft}"
                                HorizontalAlignment="Right" Margin="0" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="NEW" Style="{StaticResource BadgeText}" Foreground="{StaticResource Accent}" />
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                        <Run Text="{Binding Tag, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="16" Foreground="{StaticResource Accent}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"
                               Visibility="{Binding Meta, Converter={StaticResource NullToVis}}" />

                    <TextBlock Text="{Binding Summary.Headline}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="19" Margin="0,12,0,0"
                               Visibility="{Binding Summary.Headline, Converter={StaticResource NullToVis}}" />
                    <ItemsControl ItemsSource="{Binding Summary.Points}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" Height="4" Background="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,8,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="More in the full release notes." Style="{StaticResource MutedText}" FontSize="12"
                               Visibility="{Binding Summary.More, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="No summary for this release. The full release notes have the details." Style="{StaticResource MutedText}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Summary.IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <Border Style="{StaticResource Divider}" Margin="0,12,0,4" />
                    <Button Style="{StaticResource BtnGhost}" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" Padding="0,6"
                            Command="{Binding OpenNotesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Full release notes" />
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Component chip that opens its what's new popover; Tag is the chip's ReleaseNewsViewModel -->
        <Style x:Key="ReleaseChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,12,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsEnabled" Value="{Binding Tag.Available, RelativeSource={RelativeSource Self}}" />
            <Setter Property="IsChecked" Value="{Binding Tag.IsOpen, RelativeSource={RelativeSource Self}, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Tag.AutomationName, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,-2,0"
                                     Visibility="{Binding Tag.IsNew, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                            <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Bd}" Placement="Bottom" VerticalOffset="6" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False" v:PopupKeyboard.Enabled="True"
                                   IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ContentControl Content="{TemplateBinding Tag}" ContentTemplate="{StaticResource ReleaseCard}" Focusable="False"
                                                KeyboardNavigation.TabNavigation="Cycle" />
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <!-- A click on the chip while open only closes the popup instead of reopening it -->
                            <Trigger SourceName="Pop" Property="IsOpen" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="KeybindRow" DataType="{x:Type vm:KeybindViewModel}">
            <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{Binding ButtonText}" FontFamily="{StaticResource MonoFont}" FontWeight="Normal" AutomationProperties.Name="{Binding Label}"
                        Command="{Binding DataContext.CaptureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Capturing}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="2" Content="Default" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" ToolTip="Leave the game's default"
                        AutomationProperties.Name="{Binding Label, StringFormat='Default key for {0}'}"
                        Command="{Binding DataContext.ResetBindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                <Button Grid.Column="3" Content="Off" Style="{StaticResource BtnGhost}" ToolTip="No key" AutomationProperties.Name="{Binding Label, StringFormat='No key for {0}'}"
                        Command="{Binding DataContext.DisableBindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>


        <!-- Dropdown item that shows what the choice does under its name -->
        <Style x:Key="DescribedItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="MaxWidth" Value="440" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type vm:OptionChoice}">
                        <StackPanel Margin="0,1">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding Description, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <DataTemplate x:Key="NvOptionRow" DataType="{x:Type vm:NvOptionViewModel}">
            <Grid Margin="0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Warn}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Not applied yet" AutomationProperties.Name="Not applied yet"
                                 Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource InfoBtn}" CommandParameter="{Binding Topic}"
                                ToolTip="{Binding Topic, Converter={StaticResource HelpTip}}"
                                AutomationProperties.Name="{Binding Label, StringFormat='About {0}'}"
                                AutomationProperties.HelpText="{Binding Topic, Converter={StaticResource HelpTip}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center" ItemsSource="{Binding DisplayChoices}" SelectedItem="{Binding Selected}"
                          ItemContainerStyle="{StaticResource DescribedItem}" MaxDropDownHeight="480" AutomationProperties.Name="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <!-- Driver profile panel, shared by the global tab and the per-game view -->
        <DataTemplate x:Key="DriverPanel" DataType="{x:Type vm:DriverProfileViewModel}">
            <StackPanel>
                <Grid Margin="0,4,0,10">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,200,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Revert" Style="{StaticResource BtnGhost}" Command="{Binding RevertCommand}" IsEnabled="{Binding IsDirty}" Margin="0,0,8,0" />
                        <Button Content="Apply to driver" Style="{StaticResource BtnPrimary}" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsDirty}" />
                    </StackPanel>
                </Grid>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding FeatureSummary}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding FeatureSummary, Converter={StaticResource NullToVis}}" />
                <Border Style="{StaticResource Card}" Padding="16,4" Visibility="{Binding Loaded, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Relevant}" ItemTemplate="{StaticResource NvOptionRow}" />
                        <Button Content="{Binding OtherLabel}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,4,0,8"
                                Command="{Binding ToggleOtherCommand}" Visibility="{Binding HasOther, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Other}" ItemTemplate="{StaticResource NvOptionRow}"
                                      Visibility="{Binding ShowOther, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OptionRow" DataType="{x:Type vm:IniOptionViewModel}">
            <Grid Margin="0,9" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource InfoBtn}" CommandParameter="{Binding Topic}"
                                ToolTip="{Binding Topic, Converter={StaticResource HelpTip}}"
                                AutomationProperties.Name="{Binding Label, StringFormat='About {0}'}"
                                AutomationProperties.HelpText="{Binding Topic, Converter={StaticResource HelpTip}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}"
                          Visibility="{Binding IsToggle, Converter={StaticResource BoolToVis}}" />
                <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" ItemsSource="{Binding DisplayChoices}" SelectedItem="{Binding Selected}"
                          ItemContainerStyle="{StaticResource DescribedItem}" MaxDropDownHeight="480" AutomationProperties.Name="{Binding Label}"
                          Visibility="{Binding IsToggle, Converter={StaticResource InvBoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- Per-game option: always a dropdown (inherit / value / unset), marked when this game overrides the base -->
        <DataTemplate x:Key="GameOptionRow" DataType="{x:Type vm:GameOptionViewModel}">
            <Grid Margin="0,9" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Set for this game" AutomationProperties.Name="Set for this game"
                                 Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource InfoBtn}" CommandParameter="{Binding Topic}"
                                ToolTip="{Binding Topic, Converter={StaticResource HelpTip}}"
                                AutomationProperties.Name="{Binding Label, StringFormat='About {0}'}"
                                AutomationProperties.HelpText="{Binding Topic, Converter={StaticResource HelpTip}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ComboBox Grid.Column="1" Width="200" VerticalAlignment="Center" ItemsSource="{Binding DisplayChoices}" SelectedItem="{Binding Selected}"
                          ItemContainerStyle="{StaticResource DescribedItem}" MaxDropDownHeight="480" AutomationProperties.Name="{Binding Label}" />
                <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Content="&#xE7A7;" ToolTip="Use the base value" AutomationProperties.Name="Use the base value" HorizontalAlignment="Right"
                        Command="{Binding ResetCommand}" Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OverrideRow" DataType="{x:Type core:IniOverride}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Section}" Tag="Section" AutomationProperties.Name="Section" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="6,4" />
                <TextBox Grid.Column="1" Text="{Binding Key}" Tag="Key" AutomationProperties.Name="Key" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="6,4" Margin="8,0,0,0" />
                <TextBox Grid.Column="2" Text="{Binding Value}" Tag="Value" AutomationProperties.Name="Value" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="6,4" Margin="8,0,0,0" />
                <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Content="&#xE711;" HorizontalAlignment="Right"
                        ToolTip="Remove entry" AutomationProperties.Name="Remove entry"
                        Command="{Binding DataContext.RemoveOverrideCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid Grid.Row="0" Background="{StaticResource Bg}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Border Width="4" Height="18" Background="{StaticResource Accent}" Margin="0,0,10,0" />
                <TextBlock Text="DLSS5" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14" />
                <TextBlock Text="UPDATER" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{StaticResource Muted}" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- A newer DLSS5 Updater is out: release notes and the update, next to the caption buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" DataContext="{Binding SelfUpdate}"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <Button Content="What's new" Command="{Binding ShowNotesCommand}" Style="{StaticResource BtnGhost}" Margin="0,0,6,0"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Release notes of the new DLSS5 Updater version" />
                    <TextBlock Text="{Binding PrivateNotice}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Visibility="{Binding ShowPrivateNotice, Converter={StaticResource BoolToVis}}" MaxWidth="360" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PrivateNotice}" />
                    <Button Command="{Binding UpdateNowCommand}" Style="{StaticResource BtnPrimary}" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="{Binding UpdateName}" ToolTip="Downloads and checks the new version, then DLSS5 Updater restarts">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding UpdateText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Style="{StaticResource CaptionBtn}" Content="&#xE946;" FontSize="13" ToolTip="About" AutomationProperties.Name="About"
                        Command="{Binding ToggleAboutCommand}" />
                <Button Style="{StaticResource CaptionBtn}" Content="&#xE713;" FontSize="13" ToolTip="Settings" AutomationProperties.Name="Settings"
                        Command="{Binding ToggleSettingsCommand}" />
                <Button Style="{StaticResource CaptionBtn}" Content="&#xE921;" AutomationProperties.Name="Minimize" Click="OnMinimize" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionBtn}" Content="&#xE922;" AutomationProperties.Name="Maximize" Click="OnMaximize" />
                <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" AutomationProperties.Name="Close" Click="OnClose" />
            </StackPanel>
        </Grid>

        <!-- ============ Component strip ============ -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Background="{StaticResource Surface}">
            <Grid Margin="18,12,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Fixed-width cells so the chips line up in columns when the strip wraps -->
                <WrapPanel Orientation="Horizontal" ItemWidth="224" Margin="-8,-4,0,-4">
                    <ToggleButton Style="{StaticResource ReleaseChip}" Tag="{Binding OptiNews}" AutomationProperties.HelpText="{Binding Compat.Summary}">
                        <StackPanel>
                            <TextBlock Text="{Binding OptiChipTitle}" Style="{StaticResource Caps}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" FontSize="14" Margin="8,3,0,0"
                                           Background="Transparent" ToolTip="{Binding Compat.Summary}" ToolTipService.InitialShowDelay="100" ToolTipService.ShowOnDisabled="True"
                                           Visibility="{Binding CompatWarning, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding OptiVersion}" Style="{StaticResource ChipValue}" ToolTip="{Binding OptiVersion}" />
                            </DockPanel>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ReleaseChip}" Tag="{Binding DlssNews}">
                        <StackPanel>
                            <TextBlock Text="DLSS" Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding DlssVersion}" Style="{StaticResource ChipValue}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ReleaseChip}" Tag="{Binding UpliftNews}">
                        <StackPanel>
                            <TextBlock Text="GITC UPLIFT" Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding UpliftVersion}" Style="{StaticResource ChipValue}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ReleaseChip}" Tag="{Binding MfgNews}">
                        <StackPanel>
                            <TextBlock Text="MFG UNLOCK" Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding MfgVersion}" Style="{StaticResource ChipValue}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ReleaseChip}" Tag="{Binding StreamlineNews}">
                        <StackPanel>
                            <TextBlock Text="STREAMLINE" Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding StreamlineVersion}" Style="{StaticResource ChipValue}" />
                        </StackPanel>
                    </ToggleButton>
                    <Border Style="{StaticResource StripCell}">
                        <StackPanel>
                            <TextBlock Text="NR RUNTIME" Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding DlssNrText}" ToolTip="{Binding DlssNrText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChipValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DlssNrOk}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StripCell}" ToolTip="{Binding LecramStripTip}">
                        <StackPanel>
                            <TextBlock Text="LECRAM DLSS5" Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding LecramVersion}" Style="{StaticResource ChipValue}" ToolTip="{Binding LecramVersion}" />
                        </StackPanel>
                    </Border>
                    <ToggleButton Style="{StaticResource ReleaseChip}" Tag="{Binding ReShadeNews}">
                        <StackPanel>
                            <TextBlock Text="RESHADE" Style="{StaticResource Caps}" />
                            <TextBlock Text="{Binding ReShadeText}" ToolTip="{Binding ReShadeText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ChipValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReShadeOk}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="OFFLINE" Style="{StaticResource Caps}" Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                               Margin="0,0,14,0" Visibility="{Binding Online, Converter={StaticResource InvBoolToVis}}" />
                    <Button Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" AutomationProperties.Name="Check for updates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Check for updates" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding UpdateAllCommand}" Style="{StaticResource BtnPrimary}" AutomationProperties.Name="{Binding UpdateAllName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Update all" />
                            <Border Background="#0B0B0B" CornerRadius="2" Padding="5,0" Margin="8,0,0,0"
                                    Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UpdateCount}" Foreground="{StaticResource Accent}" FontSize="11.5" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Game list -->
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="16,16,16,10">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Tag="Search games" AutomationProperties.Name="Search games" Padding="28,7,8,7" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}" Margin="10,0,0,0"
                                   HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,0,16,0">
                        <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource Segment}" Content="All" GroupName="f"
                                         IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=All}" />
                            <RadioButton Style="{StaticResource Segment}" Content="DLSS" GroupName="f"
                                         IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=DLSS}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Installed" GroupName="f"
                                         IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=Installed}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Updates" GroupName="f"
                                         IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=Updates}" />
                        </UniformGrid>
                    </Grid>

                    <ListBox Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource GameList}" ItemContainerStyle="{StaticResource GameItem}"
                             ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}"
                             PreviewMouseLeftButtonUp="OnGameListClick" KeyUp="OnGameListKeyUp"
                             AutomationProperties.Name="Games">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameViewModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Source}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                 ToolTip="Update available" AutomationProperties.Name="Update available"
                                                 Visibility="{Binding NeedsUpdate, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <!-- Wraps instead of clipping; the installed mods come first so they always show -->
                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,-4">
                                        <WrapPanel.Resources>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                <Setter Property="Margin" Value="0,0,4,4" />
                                            </Style>
                                        </WrapPanel.Resources>
                                        <Border Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}"
                                                Visibility="{Binding ModBadge, Converter={StaticResource NullToVis}}" ToolTip="{Binding ModBadge}">
                                            <TextBlock Text="{Binding ModBadge}" Style="{StaticResource BadgeText}" Foreground="#0B0B0B" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border BorderBrush="{StaticResource Danger}"
                                                Visibility="{Binding HasAntiCheat, Converter={StaticResource BoolToVis}}" ToolTip="{Binding AntiCheat}">
                                            <TextBlock Text="AC" Style="{StaticResource BadgeText}" Foreground="{StaticResource Danger}"
                                                       AutomationProperties.Name="{Binding AntiCheat, StringFormat='{}{0} anti-cheat'}" />
                                        </Border>
                                        <Border Visibility="{Binding HasDlss, Converter={StaticResource BoolToVis}}" ToolTip="{Binding DlssOutdatedTip}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Warn}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DlssCurrent}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DlssBadgeText}" Style="{StaticResource BadgeText}" AutomationProperties.HelpText="{Binding DlssOutdatedTip}" />
                                        </Border>
                                        <Border Visibility="{Binding HasFeatureBadge, Converter={StaticResource BoolToVis}}"
                                                ToolTip="DLSS features found in the game files (Ray Reconstruction, Frame Generation, Reflex)">
                                            <TextBlock Text="{Binding FeatureBadge}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="{Binding GameListEmptyText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="24,32,24,0" VerticalAlignment="Top" IsHitTestVisible="False"
                               Visibility="{Binding GameListEmptyText, Converter={StaticResource NullToVis}}" />

                    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding AddGameFolderCommand}" ToolTip="Add a single game folder" AutomationProperties.Name="Add game">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="Add game" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding AddLibraryRootCommand}" ToolTip="Add a folder whose subfolders are games" AutomationProperties.Name="Add library">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="Add library" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnGhost}" Command="{Binding RescanCommand}" ToolTip="Rescan all folders" AutomationProperties.Name="Rescan">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                    <TextBlock Text="Rescan" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Detail -->
            <TextBlock Grid.Column="1" Text="Select a game on the left" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

            <!-- Disabled while Settings or About covers it, so Tab doesn't walk through controls nobody can see -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedGame}"
                          Visibility="{Binding Converter={StaticResource NullToVis}}">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.SettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.AboutOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="36,28,36,36" MaxWidth="980" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource BadgeText}" />
                                </Border>
                                <TextBlock Text="{Binding Root}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource BtnIcon}" Content="&#xE838;" ToolTip="Open folder" AutomationProperties.Name="Open game folder"
                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Style="{StaticResource BtnIcon}" Content="&#xE74D;" ToolTip="Remove from list" AutomationProperties.Name="Remove from list"
                                    Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Anti-cheat warning -->
                    <Border Margin="0,20,0,0" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="2,0,0,0"
                            Padding="14,10" Visibility="{Binding HasAntiCheat, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Danger}" Margin="0,0,10,0" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding AntiCheat, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" detected. Adding mods to this game can get you banned in online modes. DLSS only, which updates just the DLSS files, is safe." Foreground="{StaticResource Muted}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="Install" GroupName="{Binding Id}" Margin="0,0,24,0"
                                         IsChecked="{Binding DetailTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Install}" />
                            <RadioButton Style="{StaticResource Segment}" Content="Game config" GroupName="{Binding Id}" Margin="0,0,24,0"
                                         IsChecked="{Binding DetailTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Config}" />
                            <RadioButton Style="{StaticResource Segment}" Content="NVIDIA profile" GroupName="{Binding Id}" Visibility="{Binding ShowDriverTab, Converter={StaticResource BoolToVis}}"
                                         IsChecked="{Binding DetailTab, Converter={StaticResource EqualsToBool}, ConverterParameter=Nvidia}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding DetailTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Nvidia}" Margin="0,18,0,0">
                        <ContentPresenter Content="{Binding Driver}" ContentTemplate="{StaticResource DriverPanel}" />
                        <TextBlock Text="No executable found for this game, so there is no driver profile to match." Style="{StaticResource MutedText}"
                                   Visibility="{Binding DriverExe, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Written only to this game's NVIDIA driver profile (matched on its exe); the global profile is never changed. 'Use global' shows the global value in brackets." />
                    </StackPanel>

                    <!-- ===== Game config ===== -->
                    <StackPanel Visibility="{Binding DetailTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Config}">
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,18,0,0"
                                   Text="Values marked as set for this game override the base; everything else follows the base. Applied on the next install or update. Values you changed in-game stay only when Existing configs is set to Keep game settings." />

                        <TextBlock Text="BASE" Style="{StaticResource SectionTitle}" />
                        <ComboBox Width="320" HorizontalAlignment="Left" ItemsSource="{Binding PresetChoices}" SelectedItem="{Binding PresetChoice}"
                                  AutomationProperties.Name="Base config for this game" ToolTip="The preset (or the current settings) this game starts from" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Save as preset&#x2026;" Margin="0,0,8,0"
                                    Command="{Binding DataContext.SaveGamePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Make global" Margin="0,0,8,0" IsEnabled="{Binding IsLocalPresetSelected}" ToolTip="Let every game use this game-only preset"
                                    Command="{Binding DataContext.MakeGamePresetGlobalCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Delete preset" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" IsEnabled="{Binding IsLocalPresetSelected}"
                                    Command="{Binding DataContext.DeleteGamePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Reset game config" Style="{StaticResource BtnGhost}" ToolTip="Remove every change made for this game"
                                    Command="{Binding DataContext.ResetGameConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="EXISTING CONFIGS" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,12,0" Width="140" />
                            <ComboBox Width="240" ItemsSource="{Binding IniModeChoices}" SelectedItem="{Binding IniModeChoice}"
                                      ItemContainerStyle="{StaticResource DescribedItem}" AutomationProperties.Name="Existing configs" ToolTip="How this game treats its existing OptiScaler.ini / ReShade.ini" />
                            <Button Style="{StaticResource InfoBtn}" CommandParameter="ini-mode" VerticalAlignment="Center"
                                    ToolTip="{Binding Source=ini-mode, Converter={StaticResource HelpTip}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="SHOW OPTIONS FOR" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,12,0" Width="140" />
                            <ComboBox Width="240" ItemsSource="{Binding ModChoices}" SelectedItem="{Binding ModSelection}"
                                      AutomationProperties.Name="Mod whose options are shown" ToolTip="Show the options of one mod at a time. Starts with the mod this game uses." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowReShade, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="RESHADE" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding ReShadeRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowUplift, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GITC UPLIFT" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding UpliftRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowMfg, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MFG UNLOCK" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding MfgRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowRenoDx, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="SHORTFUSE RENODX DLSS ADD-ON" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding RenoDxRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowLecram, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LECRAM DLSS5 ADD-ON" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding LecramRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowDfc, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DEEP FRIED CHICKEN" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding DfcRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowOptiNr, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="NEURAL RENDERING" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding NrRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                            <TextBlock Text="HDR TONE MAPPING" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding TonemapRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                            <TextBlock Text="HDR OUTPUT" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource Card}" Padding="16,4">
                                <ItemsControl ItemsSource="{Binding HdrRows}" ItemTemplate="{StaticResource GameOptionRow}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding DetailTab, Converter={StaticResource EqualsToVis}, ConverterParameter=Install}">
                    <!-- Target -->
                    <TextBlock Text="INSTALL LOCATION" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" AutomationProperties.Name="Install location" />
                        <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Content="&#xE8DA;" Margin="6,0,12,0" ToolTip="Choose folder" AutomationProperties.Name="Choose install folder"
                                Command="{Binding DataContext.BrowseTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ProxyNames}" SelectedItem="{Binding Proxy}" AutomationProperties.Name="Proxy file name"
                                  ToolTip="File name the game loads the mod as" />
                    </Grid>
                    <TextBlock Text="{Binding ProxyHint}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="INSTALL MODE" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,12,0" Width="140" />
                        <ComboBox Width="240" ItemsSource="{Binding Modes}" SelectedItem="{Binding ModeChoice}"
                                  ItemContainerStyle="{StaticResource DescribedItem}" AutomationProperties.Name="Install mode"
                                  ToolTip="{Binding ModeHint}" />
                        <Button Style="{StaticResource InfoBtn}" CommandParameter="install-mode" VerticalAlignment="Center"
                                ToolTip="{Binding Source=install-mode, Converter={StaticResource HelpTip}}" />
                    </StackPanel>

                    <!-- Components -->
                    <TextBlock Text="COMPONENTS" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="16,10,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="COMPONENT" Style="{StaticResource Caps}" />
                                <TextBlock Grid.Column="2" Text="INSTALLED" Style="{StaticResource Caps}" />
                                <TextBlock Grid.Column="3" Text="LATEST" Style="{StaticResource Caps}" />
                                <TextBlock Grid.Column="4" Text="INSTALL" Style="{StaticResource Caps}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ComponentRow}">
                                        <Grid Margin="16,9" Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" HorizontalAlignment="Left" Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                                     ToolTip="{Binding State, Converter={StaticResource StateToText}}"
                                                     AutomationProperties.Name="{Binding State, Converter={StaticResource StateToText}}" />
                                            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource InfoBtn}" CommandParameter="{Binding HelpTopic}"
                                                        ToolTip="{Binding HelpTopic, Converter={StaticResource HelpTip}}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat='About {0}'}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </DockPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Installed}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Latest}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Key}" Value="renodx"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Key}" Value="lecram"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Key}" Value="dfc"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Key}" Value="opti"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Key}" Value="uplift"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- OptiScaler and GITC Uplift pick the downloaded build this game installs. -->
                                            <ComboBox Grid.Column="3" Margin="0,0,8,0" MaxDropDownHeight="300"
                                                      Visibility="{Binding Key, Converter={StaticResource EqualsToVis}, ConverterParameter=opti}"
                                                      ItemsSource="{Binding DataContext.OptiChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding DataContext.OptiChoice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      AutomationProperties.Name="OptiScaler version for this game" ToolTip="Which OptiScaler build this game installs; Default follows Settings" />
                                            <ComboBox Grid.Column="3" Margin="0,0,8,0" MaxDropDownHeight="300"
                                                      Visibility="{Binding Key, Converter={StaticResource EqualsToVis}, ConverterParameter=uplift}"
                                                      ItemsSource="{Binding DataContext.UpliftChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding DataContext.UpliftChoice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      AutomationProperties.Name="GITC Uplift version for this game" ToolTip="Which GITC Uplift build this game installs; Default follows Settings" />
                                            <!-- The add-on rows pick the imported build this game installs. -->
                                            <ComboBox Grid.Column="3" Margin="0,0,8,0" MaxDropDownHeight="300"
                                                      Visibility="{Binding Key, Converter={StaticResource EqualsToVis}, ConverterParameter=renodx}"
                                                      ItemsSource="{Binding DataContext.RenoDxChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding DataContext.RenoDxChoice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      AutomationProperties.Name="ShortFuse RenoDX DLSS version for this game" ToolTip="Which imported ShortFuse build this game installs" />
                                            <ComboBox Grid.Column="3" Margin="0,0,8,0" MaxDropDownHeight="300"
                                                      Visibility="{Binding Key, Converter={StaticResource EqualsToVis}, ConverterParameter=lecram}"
                                                      ItemsSource="{Binding DataContext.LecramChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding DataContext.LecramChoice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      AutomationProperties.Name="Lecram DLSS5 version for this game" ToolTip="Which imported Lecram build this game installs; its generation decides which Lecram options apply" />
                                            <ComboBox Grid.Column="3" Margin="0,0,8,0" MaxDropDownHeight="300"
                                                      Visibility="{Binding Key, Converter={StaticResource EqualsToVis}, ConverterParameter=dfc}"
                                                      ItemsSource="{Binding DataContext.DfcChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding DataContext.DfcChoice, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      AutomationProperties.Name="Deep Fried Chicken version for this game" ToolTip="Which imported Deep Fried Chicken build this game installs; it decides the files, the default cfg and whether games without DLSS work" />
                                            <CheckBox Grid.Column="4" IsChecked="{Binding Enabled}" IsEnabled="{Binding Editable}" HorizontalAlignment="Right" ToolTip="Include in install"
                                                      AutomationProperties.Name="{Binding Name, StringFormat='Install {0}'}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="16,4,16,12" Visibility="{Binding BothAddonsEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="ShortFuse + Lecram pair" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PairStatusText}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding NrAddonWarning}" Style="{StaticResource MutedText}" Foreground="{StaticResource Warn}" FontSize="11.5" TextWrapping="Wrap" Margin="18,4,0,0" />
                                <WrapPanel Margin="18,6,0,0">
                                    <Button Content="Mark as working" Style="{StaticResource BtnGhost}" Command="{Binding MarkPairWorkingCommand}" Margin="0,0,8,0" />
                                    <Button Content="Mark as crashed" Style="{StaticResource BtnGhost}" Command="{Binding MarkPairCrashedCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding SfLecramMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="18,8,0,0" Foreground="{StaticResource Warn}"
                                           Visibility="{Binding HasSfLecramMessage, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <!-- Deep Fried Chicken in a game without its own DLSS: what changes, and the DLSS-G runtime for its frame generation. -->
                            <TextBlock Text="{Binding DfcNoDlssWarning}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12" Margin="34,4,16,12"
                                       Visibility="{Binding HasDfcNoDlssWarning, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Margin="34,4,16,12" Visibility="{Binding ShowDfcNoDlssHint, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource InfoBtn}" CommandParameter="dfc-no-dlss" VerticalAlignment="Top"
                                            ToolTip="{Binding Source=dfc-no-dlss, Converter={StaticResource HelpTip}}" AutomationProperties.Name="About Deep Fried Chicken in games without DLSS" />
                                    <TextBlock Text="{x:Static vm:GameViewModel.DfcNoDlssHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" />
                                </DockPanel>
                                <CheckBox IsChecked="{Binding DfcFrameGen}" Margin="0,8,0,0" AutomationProperties.Name="Add NVIDIA's frame generation file (nvngx_dlssg.dll) for Deep Fried Chicken (RTX 40/50)"
                                          ToolTip="NVIDIA's frame generation runtime from the DLSS release, placed beside the exe and removed with DFC. FSR 3.1 frame generation needs AMD's amd_fidelityfx_*_dx12.dll, which this app does not provide.">
                                    <TextBlock Text="Add NVIDIA's frame generation file (nvngx_dlssg.dll) for Deep Fried Chicken (RTX 40/50)" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NR RUNTIME VERSION" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Which NR runtime this game gets when you install or update it. Default uses the one chosen in Settings → Local components. Switch NR puts your choice into the installed game now; Switch back restores the previous file. With a 310.9 runtime, compare models with the Preset option instead of switching versions."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding NrChoices}" SelectedItem="{Binding NrChoice}" MaxDropDownHeight="300"
                                      AutomationProperties.Name="NR runtime version for this game" />
