                                <Button Content="Switch NR" Command="{Binding DataContext.SwitchNrCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Button Content="Switch back" Command="{Binding DataContext.UndoNrCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        IsEnabled="{Binding CanUndoNr}" Margin="8,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- DLSS files -->
                    <Grid>
                        <TextBlock Text="DLSS FILES" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                            <TextBlock Text="VERSION" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Width="220" MaxDropDownHeight="360" ItemsSource="{Binding DlssChoices}" SelectedItem="{Binding DlssChoice}"
                                      AutomationProperties.Name="DLSS version for this game" ToolTip="Pin a DLSS version for this game" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DlssRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DlssRow}">
                                        <Grid Margin="16,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" HorizontalAlignment="Left" Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                                     ToolTip="{Binding State, Converter={StaticResource StateToText}}"
                                                     AutomationProperties.Name="{Binding State, Converter={StaticResource StateToText}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding RelPath}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding RelPath}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
                                                <TextBlock Text="{Binding Current}" Style="{StaticResource Mono}" />
                                                <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Dim}" Margin="10,0" AutomationProperties.Name="to" />
                                                <TextBlock Text="{Binding Latest}" Style="{StaticResource Mono}" Foreground="{StaticResource Accent}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="16,12" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="No DLSS files in this game. In OptiScaler mode, with Settings → Add nvngx_dlss.dll to games that ship without it turned on, installing adds nvngx_dlss.dll next to the game's .exe."
                                       Visibility="{Binding HasDlss, Converter={StaticResource InvBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}" Padding="22,9" MinWidth="130" AutomationProperties.Name="{Binding ActionText}"
                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    IsEnabled="{Binding AnyEnabled}">
                                <TextBlock Text="{Binding ActionText}" />
                            </Button>
                            <Button Content="DLSS only" Margin="8,0,0,0" Padding="16,9" ToolTip="Update only the game's DLSS files. No mods are added."
                                    Command="{Binding DataContext.DlssOnlyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Restore DLSS" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" ToolTip="Put back the game's original DLSS and Streamline files"
                                    Command="{Binding DataContext.RestoreDlssCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Uninstall" Style="{StaticResource BtnDanger}" Padding="16,9" ToolTip="Remove everything DLSS5 Updater added and restore the original files"
                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings overlay -->
            <Border Grid.Column="1" Background="{StaticResource Bg}" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
                <v:Deferred x:Name="SettingsHost" Show="{Binding SettingsOpen}">
                    <v:Deferred.Template>
                        <DataTemplate>
                            <Grid DataContext="{Binding SettingsVm}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="36,28,36,0" MaxWidth="860">
                                    <Grid>
                                        <TextBlock Text="Settings" Style="{StaticResource H1}" />
                                        <Button Style="{StaticResource BtnIcon}" Content="&#xE8BB;" HorizontalAlignment="Right" ToolTip="Close" AutomationProperties.Name="Close settings"
                                                Command="{Binding DataContext.ToggleSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <Grid Margin="0,16,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="PRESET" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ComboBox Width="200" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}"
                                                      AutomationProperties.Name="Preset" ToolTip="Load a saved preset into the settings below" />
                                            <Button Content="Save as…" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Command="{Binding SavePresetCommand}" />
                                            <Button Content="Delete" Style="{StaticResource BtnGhost}" Command="{Binding DeletePresetCommand}"
                                                    Visibility="{Binding CanDeletePreset, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource InfoBtn}" CommandParameter="presets" VerticalAlignment="Center"
                                                    ToolTip="{Binding Source=presets, Converter={StaticResource HelpTip}}" />
                                        </StackPanel>
                                        <Button Content="Reset to defaults" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Command="{Binding ResetAllCommand}"
                                                ToolTip="Put all OptiScaler and ReShade settings, keybinds and options back to what each project ships with" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="General" GroupName="st" Margin="0,0,24,0"
                                                         IsChecked="{Binding Tab, Converter={StaticResource EqualsToBool}, ConverterParameter=General}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Keybinds" GroupName="st" Margin="0,0,24,0"
                                                         IsChecked="{Binding Tab, Converter={StaticResource EqualsToBool}, ConverterParameter=Keybinds}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="ReShade add-ons" GroupName="st" Margin="0,0,24,0"
                                                         IsChecked="{Binding Tab, Converter={StaticResource EqualsToBool}, ConverterParameter=ReShade}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="{Binding OptiName}" GroupName="st" Margin="0,0,24,0"
                                                         IsChecked="{Binding Tab, Converter={StaticResource EqualsToBool}, ConverterParameter=Nr}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Advanced" GroupName="st"
                                                         IsChecked="{Binding Tab, Converter={StaticResource EqualsToBool}, ConverterParameter=Advanced}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="36,0,36,36" MaxWidth="860">

                                        <!-- ===== General ===== -->
                                        <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=General}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="LOCAL COMPONENTS" Style="{StaticResource SectionTitle}" />
                                                <Button Style="{StaticResource InfoBtn}" CommandParameter="local-components" Margin="4,18,0,0"
                                                        ToolTip="{Binding Source=local-components, Converter={StaticResource HelpTip}}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource Card}" Padding="16,4">
                                                <StackPanel>
                                                        <StackPanel.Resources>
                                                            <DataTemplate x:Key="AddonLibraryRow" DataType="{x:Type vm:AddonLibraryViewModel}">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding FileNames}" Style="{StaticResource Mono}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                                            <Button Content="Remove" Style="{StaticResource BtnGhost}" Command="{Binding RemoveCommand}" Margin="12,0,0,0"
                                                                                    Visibility="{Binding HasBuilds, Converter={StaticResource BoolToVis}}"
                                                                                    ToolTip="Remove the selected build from the library; other builds stay" />
                                                                            <Button Content="Folder…" Style="{StaticResource BtnGhost}" Command="{Binding ImportFolderCommand}" Margin="12,0,0,0"
                                                                                    Visibility="{Binding CanImportFolder, Converter={StaticResource BoolToVis}}"
                                                                                    ToolTip="Add the extracted release folder or its 64-bit folder to the library" />
                                                                            <Button Content="Import…" Command="{Binding ImportCommand}" Margin="12,0,0,0"
                                                                                    ToolTip="Add a build to the library; builds already there are kept" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Visibility="{Binding HasBuilds, Converter={StaticResource BoolToVis}}">
                                                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" MaxDropDownHeight="300" Margin="0,8,0,0"
                                                                                  AutomationProperties.Name="{Binding AutomationName}" ToolTip="Default build: games without their own pick install it" />
                                                                        <Grid Margin="0,6,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBox Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged}" Tag="Your own name for the selected build, e.g. v10.1"
                                                                                     AutomationProperties.Name="Name of the selected build" />
                                                                            <Button Grid.Column="1" Content="Save name" Command="{Binding RenameCommand}" Margin="12,0,0,0"
                                                                                    ToolTip="Show this name instead of the detected one. Empty goes back to the detected name." />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Info}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                                                                    <StackPanel Visibility="{Binding CanCheckUpdates, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                                                        <WrapPanel>
                                                                            <CheckBox Content="Check for new builds automatically" IsChecked="{Binding AutoDownload}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                                            <Button Content="Check now" Command="{Binding CheckNowCommand}" Style="{StaticResource BtnGhost}" />
                                                                        </WrapPanel>
                                                                        <TextBlock Text="{Binding LastResult}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </StackPanel.Resources>
                                                    <Grid Margin="0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="nvngx_dlssnr.dll" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DlssNrInfo}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                                        <Button Grid.Column="2" Content="Import…" Command="{Binding ImportDlssNrCommand}" Margin="12,0,0,0" />
                                                    </Grid>
                                                    <StackPanel Margin="0,0,0,12">
                                                        <TextBlock Text="Default NR runtime" Margin="0,0,0,6" />
                                                        <ComboBox ItemsSource="{Binding NrChoices}" SelectedItem="{Binding SelectedNr}" MaxDropDownHeight="300"
                                                                  AutomationProperties.Name="Default NR runtime" />
                                                        <TextBlock Text="{Binding SelectedNrHint}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                        <Button Content="Switch default back" Command="{Binding UndoNrDefaultCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                    <Border Style="{StaticResource Divider}" />
                                                    <Grid Margin="0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="ReShade64.dll" Style="{StaticResource Mono}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ReShadeInfo}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Content="Use download" Style="{StaticResource BtnGhost}" Command="{Binding UseReShadeDownloadCommand}" Margin="12,0,0,0"
                                                                    Visibility="{Binding ReShadeImported, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Remove the imported ReShade64.dll and use the latest add-on build from reshade.me" />
                                                            <Button Content="Import…" Command="{Binding ImportReShadeCommand}" Margin="12,0,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <CheckBox IsChecked="{Binding AutoDownloadReShade}" Margin="0,0,0,10" AutomationProperties.Name="Download ReShade (add-on build) from reshade.me when none is imported">
                                                        <TextBlock Text="Download ReShade (add-on build) from reshade.me when none is imported" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <Border Style="{StaticResource Divider}" />
                                                    <ContentControl Content="{Binding RenoDx}" ContentTemplate="{StaticResource AddonLibraryRow}" Margin="0,10" />
                                                    <Border Style="{StaticResource Divider}" />
                                                    <ContentControl Content="{Binding Lecram}" ContentTemplate="{StaticResource AddonLibraryRow}" Margin="0,10" />
                                                    <TextBlock Text="{Binding LecramMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" Foreground="{StaticResource Warn}"
                                                               Visibility="{Binding HasLecramMessage, Converter={StaticResource BoolToVis}}" />
                                                    <Border Style="{StaticResource Divider}" />
                                                    <ContentControl Content="{Binding Dfc}" ContentTemplate="{StaticResource AddonLibraryRow}" Margin="0,10" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Import each NR runtime you want to keep; they all stay in your library. NVIDIA's original needs an RTX 50 card. For RTX 20/30/40, download and extract ShortFuse's compat build (compat-fp16-310.9.16-cuda13.4.3) and import it. ReShade is downloaded from reshade.me."
                                                       Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />

                                            <Button Content="Import DLSS SR / RR / FG…" Command="{Binding ImportDlssCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                    ToolTip="Adds your own DLSS files as a version and makes it the default DLSS version." />
                                            <TextBlock Text="DEFAULTS" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,6">
                                                <StackPanel>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Install mode" VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource InfoBtn}" CommandParameter="install-mode"
                                                                ToolTip="{Binding Source=install-mode, Converter={StaticResource HelpTip}}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Width="170" Margin="16,0,0,0" ItemsSource="{Binding Modes}" SelectedItem="{Binding DefaultMode}"
                                                                  ItemContainerStyle="{StaticResource DescribedItem}" AutomationProperties.Name="Default install mode" />
                                                    </Grid>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Proxy file name" VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource InfoBtn}" CommandParameter="proxy"
                                                                ToolTip="{Binding Source=proxy, Converter={StaticResource HelpTip}}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Width="170" Margin="16,0,0,0" ItemsSource="{Binding ProxyNames}" SelectedItem="{Binding DefaultProxy}"
                                                                  AutomationProperties.Name="Default proxy file name" />
                                                    </Grid>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="DLSS version" VerticalAlignment="Center" />
                                                                <Button Style="{StaticResource InfoBtn}" CommandParameter="dlss-version"
                                                                ToolTip="{Binding Source=dlss-version, Converter={StaticResource HelpTip}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="The chosen version is installed as is, even if the game has a newer one. Each game can choose its own." Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Width="170" Margin="16,0,0,0" VerticalAlignment="Center" MaxDropDownHeight="360"
                                                                  ItemsSource="{Binding DlssChoices}" SelectedItem="{Binding SelectedDlss}" AutomationProperties.Name="Default DLSS version" />
                                                    </Grid>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="OptiScaler build" VerticalAlignment="Center" />
                                                                <Button Style="{StaticResource InfoBtn}" CommandParameter="opti-build"
                                                                ToolTip="{Binding Source=opti-build, Converter={StaticResource HelpTip}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="F5 (janblade) is experimental and releases often. Games keep their build until updated." Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Width="190" Margin="16,0,0,0" VerticalAlignment="Center"
                                                                  ItemsSource="{Binding OptiBuilds}" DisplayMemberPath="Label" SelectedItem="{Binding OptiBuild}"
                                                                  AutomationProperties.Name="OptiScaler build" />
                                                    </Grid>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="OptiScaler version" VerticalAlignment="Center" />
                                                            <TextBlock Text="Newest follows each release. Pick a kept build to stay on it; each game can choose its own." Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Width="250" Margin="16,0,0,0" VerticalAlignment="Center" MaxDropDownHeight="360"
                                                                  ItemsSource="{Binding OptiVersionChoices}" SelectedItem="{Binding SelectedOptiVersion}"
                                                                  AutomationProperties.Name="Default OptiScaler version" />
                                                    </Grid>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="GITC Uplift version" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" Width="250" Margin="16,0,0,0" VerticalAlignment="Center" MaxDropDownHeight="360"
                                                                  ItemsSource="{Binding UpliftVersionChoices}" SelectedItem="{Binding SelectedUpliftVersion}"
                                                                  AutomationProperties.Name="Default GITC Uplift version" />
                                                    </Grid>
                                                    <CheckBox IsChecked="{Binding IncludePrereleases}" Margin="0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Include pre-releases" VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource InfoBtn}" CommandParameter="prereleases"
                                                                ToolTip="{Binding Source=prereleases, Converter={StaticResource HelpTip}}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <CheckBox Content="Install ReShade" IsChecked="{Binding InstallReShade}" Margin="0,8" />
                                                    <CheckBox IsChecked="{Binding InstallMfgUnlock}" Margin="0,8" AutomationProperties.Name="Install MFG Unlock (RTX 40; only games with DLSS frame generation through Streamline)">
                                                        <TextBlock Text="Install MFG Unlock (RTX 40; only games with DLSS frame generation through Streamline)" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <CheckBox IsChecked="{Binding InstallRenoDx}" Margin="0,8" AutomationProperties.Name="Install ShortFuse RenoDX DLSS add-on (ReShade + add-ons mode; runs its own NR; needs ReShade 6+ and the NR runtime)">
                                                        <TextBlock Text="Install ShortFuse RenoDX DLSS add-on (ReShade + add-ons mode; runs its own NR; needs ReShade 6+ and the NR runtime)" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <CheckBox IsChecked="{Binding InstallUplift}" Margin="0,8" AutomationProperties.Name="Install GITC Uplift (ReShade + add-ons mode; exclusive NR route, 64-bit only; uses your imported NR runtime)">
                                                        <TextBlock Text="Install GITC Uplift (ReShade + add-ons mode; exclusive NR route, 64-bit only; uses your imported NR runtime)" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <CheckBox IsChecked="{Binding InstallLecram}" Margin="0,8" AutomationProperties.Name="Install Lecram DLSS5 add-on (ReShade + add-ons mode; runs its own NR; needs ReShade 6+ and the NR runtime)">
                                                        <TextBlock Text="Install Lecram DLSS5 add-on (ReShade + add-ons mode; runs its own NR; needs ReShade 6+ and the NR runtime)" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <CheckBox IsChecked="{Binding AllowSeveralNrAddons}" Margin="0,4,0,8"
                                                              AutomationProperties.Name="Allow more than one NR add-on (only ShortFuse and Lecram can run together)">
                                                        <TextBlock Text="Allow more than one NR add-on (only ShortFuse and Lecram can run together)" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding NrAddonWarning}" Style="{StaticResource MutedText}" Foreground="{StaticResource Warn}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                                               Visibility="{Binding NrAddonWarning, Converter={StaticResource NullToVis}}" />
                                                    <CheckBox IsChecked="{Binding InstallDlssNr}" Margin="0,8" AutomationProperties.Name="Install NR runtime (nvngx_dlssnr.dll)">
                                                        <TextBlock Text="Install NR runtime (nvngx_dlssnr.dll)" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <CheckBox IsChecked="{Binding InstallStreamline}" Margin="0,8">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Replace the game's Streamline files with the latest SDK" VerticalAlignment="Center" />
                                                                <Button Style="{StaticResource InfoBtn}" CommandParameter="streamline"
                                                                ToolTip="{Binding Source=streamline, Converter={StaticResource HelpTip}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="For Dynamic MFG (needs DLSS FG 310.9.1 with Streamline 2.14.1, or 310.9.16 with 2.14.16). Only files the game already ships are swapped, always as one set."
                                                                       Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <CheckBox IsChecked="{Binding AddMissingDlss}" Margin="0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Add nvngx_dlss.dll to games that ship without it" VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource InfoBtn}" CommandParameter="add-missing"
                                                                ToolTip="{Binding Source=add-missing, Converter={StaticResource HelpTip}}" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Existing game configs" VerticalAlignment="Center" />
                                                            <Button Style="{StaticResource InfoBtn}" CommandParameter="ini-mode"
                                                                    ToolTip="{Binding Source=ini-mode, Converter={StaticResource HelpTip}}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Width="210" Margin="16,0,0,0" ItemsSource="{Binding IniModes}" SelectedItem="{Binding IniMode}"
                                                                  ItemContainerStyle="{StaticResource DescribedItem}" AutomationProperties.Name="Existing game configs" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Old builds of every library and download leftovers; what games need always stays. -->
                                            <TextBlock Text="BUILD LIBRARY" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,6" DataContext="{Binding Cleanup}">
                                                <StackPanel>
                                                    <TextBlock Text="Downloaded and imported builds stay so games can switch back. Cleanup keeps the newest builds of each library (per OptiScaler source) and always keeps defaults, builds chosen for a game, builds installed in one and the NR runtime a game can switch back to; a row says why it holds more builds than the number you keep. Builds you imported only go when you clean up by hand."
                                                               Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,4" />
                                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:LibraryRowViewModel}">
                                                                <Grid Margin="0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="190" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="Keep newest" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0" />
                                                                    <ComboBox Grid.Column="3" Width="64" ItemsSource="{x:Static vm:LibraryRowViewModel.KeepChoices}" SelectedItem="{Binding Keep}"
                                                                              AutomationProperties.Name="{Binding Title, StringFormat='Keep this many newest {0} builds'}" />
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Note}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0"
                                                                               ToolTip="{Binding NoteDetails}"
                                                                               Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <CheckBox IsChecked="{Binding AutoClean}" Margin="0,10,0,4" AutomationProperties.Name="Delete old downloads automatically after each download">
                                                        <TextBlock Text="Delete old downloads automatically after each download (imported builds always stay)" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding AutoSkipped}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="26,0,0,2"
                                                               Visibility="{Binding AutoSkipped, Converter={StaticResource NullToVis}}" />
                                                    <Grid Margin="0,6,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Freeable}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Content="Clean up old builds…" Command="{Binding CleanCommand}" Margin="12,0,0,0"
                                                                ToolTip="Shows what goes and how much space it frees, then asks before deleting" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="GAME FOLDERS" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,6">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Folders}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:FolderEntry}">
                                                                <Grid Margin="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="70" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Caps}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Content="&#xE711;" ToolTip="Remove folder" AutomationProperties.Name="Remove folder"
                                                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="Steam, Epic, GOG, EA, Ubisoft and Xbox games are found automatically." Style="{StaticResource MutedText}"
                                                               FontSize="12" Margin="0,6" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <Button Content="Add game folder" Margin="0,0,8,0"
                                                                Command="{Binding DataContext.AddGameFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <Button Content="Add library folder" Margin="0,0,8,0"
                                                                Command="{Binding DataContext.AddLibraryRootCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <Button Content="Show hidden games" Style="{StaticResource BtnGhost}" Command="{Binding ShowHiddenCommand}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="DLSS5 UPDATER UPDATES" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,6"
                                                    DataContext="{Binding DataContext.SelfUpdate, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <StackPanel>
                                                    <CheckBox Content="Check for updates" IsChecked="{Binding CheckAppUpdates}" Margin="0,8" />
                                                    <CheckBox IsChecked="{Binding AutoInstall}" Margin="0,8" AutomationProperties.Name="Install updates automatically" Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock Text="Install updates automatically" />
                                                            <TextBlock Text="Downloads in the background, checks it against the release's SHA256SUMS and installs when DLSS5 Updater closes. Never during a running task."
                                                                       Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <TextBlock Text="{Binding LastResult}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding PrivateNotice}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                               Visibility="{Binding ShowPrivateNotice, Converter={StaticResource BoolToVis}}" />
                                                    <WrapPanel Margin="0,10,0,6">
                                                        <Button Content="Check now" Command="{Binding CheckNowCommand}" Margin="0,0,8,0" />
                                                        <Button Content="{Binding UpdateText}" Command="{Binding UpdateNowCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                                                                Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="What's new" Command="{Binding ShowNotesCommand}" Style="{StaticResource BtnGhost}"
                                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Text="GITHUB TOKEN (OPTIONAL)" Style="{StaticResource SectionTitle}" />
                                            <TextBox Text="{Binding GitHubToken, UpdateSourceTrigger=LostFocus}" Tag="Only needed if update checks hit GitHub's request limit"
                                                     AutomationProperties.Name="GitHub token" />

                                            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                                                <Button Content="Open data folder" Style="{StaticResource BtnGhost}" Command="{Binding OpenDataFolderCommand}" />
                                                <Button Content="Run setup again" Style="{StaticResource BtnGhost}" Command="{Binding RunSetupCommand}" Margin="8,0,0,0"
                                                        ToolTip="Opens the first-run setup again; it starts at your current settings" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ===== Keybinds ===== -->
                                        <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=Keybinds}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="OPTISCALER" Style="{StaticResource SectionTitle}" />
                                                <Button Style="{StaticResource InfoBtn}" CommandParameter="keybinds" Margin="4,18,0,0"
                                                        ToolTip="{Binding Source=keybinds, Converter={StaticResource HelpTip}}" />
                                            </StackPanel>
                                            <Border Style="{StaticResource Card}" Padding="16,4">
                                                <ItemsControl ItemsSource="{Binding OptiKeybinds}" ItemTemplate="{StaticResource KeybindRow}" />
                                            </Border>
                                            <TextBlock Text="RESHADE" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,4">
                                                <ItemsControl ItemsSource="{Binding ReShadeKeybinds}" ItemTemplate="{StaticResource KeybindRow}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Text="Click a key, then press the new one (Esc cancels). ReShade keys may include Ctrl / Shift / Alt. Applied on the next install or update. Keys you changed in-game stay only when Existing configs is set to Keep game settings." />
                                        </StackPanel>

                                        <!-- ===== ReShade add-ons ===== -->
                                        <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=ReShade}">
                                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                <TextBlock Text="SHOW DEFAULTS FOR" Style="{StaticResource Caps}" VerticalAlignment="Center" Margin="0,0,12,0" Width="140" />
                                                <ComboBox Width="240" ItemsSource="{Binding ModChoices}" SelectedItem="{Binding ModSelection}"
                                                          AutomationProperties.Name="Mod whose defaults are shown" ToolTip="Show the defaults of one mod at a time. Starts with the mod your default install uses." />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding ShowReShade, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="RESHADE" Style="{StaticResource SectionTitle}" />
                                                <Border Style="{StaticResource Card}" Padding="16,4">
                                                    <ItemsControl ItemsSource="{Binding ReShadeOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding ShowMfg, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="MFG UNLOCK" Style="{StaticResource SectionTitle}" />
                                                <Border Style="{StaticResource Card}" Padding="16,4">
                                                    <ItemsControl ItemsSource="{Binding MfgOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding ShowRenoDx, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="SHORTFUSE RENODX DLSS ADD-ON" Style="{StaticResource SectionTitle}" />
                                                <Border Style="{StaticResource Card}" Padding="16,4">
                                                    <ItemsControl ItemsSource="{Binding RenoDxOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding ShowUplift, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="GITC UPLIFT" Style="{StaticResource SectionTitle}" />
                                                <Border Style="{StaticResource Card}" Padding="16,4">
                                                    <ItemsControl ItemsSource="{Binding UpliftOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding ShowLecram, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="LECRAM DLSS5 ADD-ON" Style="{StaticResource SectionTitle}" />
                                                <Border Style="{StaticResource Card}" Padding="16,4">
                                                    <ItemsControl ItemsSource="{Binding LecramOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding ShowDfc, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="DEEP FRIED CHICKEN" Style="{StaticResource SectionTitle}" />
                                                <Border Style="{StaticResource Card}" Padding="16,4">
                                                    <ItemsControl ItemsSource="{Binding DfcOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding ShowDfc, Converter={StaticResource BoolToVis}}"
                                                       Text="Deep Fried Chicken keys are written to deep-fried-chicken.cfg next to the game, only the ones you set; everything else in that file stays. Other settings are tuned in the ReShade overlay." />
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Text="Written to ReShade.ini next to the game's .exe. The RenoDX and Lecram options only apply when that add-on is installed; Lecram options that the imported generation lacks are hidden. For Dynamic MFG also set the NVIDIA App's DLSS Frame Generation override to 'Use the 3D application setting', then fully close and restart the game." />
                                        </StackPanel>

                                        <!-- ===== OptiScaler (name follows the selected build) ===== -->
                                        <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=Nr}">
                                            <TextBlock Text="NEURAL RENDERING" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,4">
                                                <ItemsControl ItemsSource="{Binding NrOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                            </Border>
                                            <TextBlock Text="HDR TONE MAPPING" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,4">
                                                <ItemsControl ItemsSource="{Binding TonemapOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                            </Border>
                                            <TextBlock Text="HDR OUTPUT" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource Card}" Padding="16,4">
                                                <ItemsControl ItemsSource="{Binding HdrOptions}" ItemTemplate="{StaticResource OptionRow}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Text="Written to OptiScaler.ini. Tone mapping only applies to games that render in linear light (most HDR games); frames the game already tone-mapped pass through untouched. Everything can also be changed live in the OptiScaler menu." />
                                        </StackPanel>

                                        <!-- ===== Advanced ===== -->
                                        <StackPanel Visibility="{Binding Tab, Converter={StaticResource EqualsToVis}, ConverterParameter=Advanced}">
                                            <Grid>
                                                <TextBlock Text="OPTISCALER.INI" Style="{StaticResource SectionTitle}" />
                                                <Button Style="{StaticResource BtnGhost}" Command="{Binding AddOverrideCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                        AutomationProperties.Name="Add OptiScaler.ini entry">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Add" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Border Style="{StaticResource Card}" Padding="16,10">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Overrides}" ItemTemplate="{StaticResource OverrideRow}" />
                                                    <TextBlock Text="No entries. Use Add to write a raw key.">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Overrides.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <Grid>
                                                <TextBlock Text="RESHADE.INI" Style="{StaticResource SectionTitle}" />
                                                <Button Style="{StaticResource BtnGhost}" Command="{Binding AddReShadeOverrideCommand}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                        AutomationProperties.Name="Add ReShade.ini entry">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Add" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Border Style="{StaticResource Card}" Padding="16,10">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding ReShadeOverrides}" ItemTemplate="{StaticResource OverrideRow}" />
                                                    <TextBlock Text="No entries. Use Add to write a raw key.">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ReShadeOverrides.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Text="Raw section / key / value pairs, also edited by the Keybinds, ReShade add-ons and OptiScaler tabs. A value a game already set itself is kept; values written by this app follow your changes." />
                                            <Button Content="Reset to defaults" Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Margin="0,16,0,0"
                                                    Command="{Binding ResetAllCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </DataTemplate>
                    </v:Deferred.Template>
                </v:Deferred>
            </Border>

            <!-- About overlay -->
            <Border Grid.Column="1" Background="{StaticResource Bg}" Visibility="{Binding AboutOpen, Converter={StaticResource BoolToVis}}">
                <v:Deferred x:Name="AboutHost" Show="{Binding AboutOpen}">
                    <v:Deferred.Template>
                        <DataTemplate>
                            <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="26,8">
                                <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Left" Command="{Binding BackCommand}" AutomationProperties.Name="Back">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Back" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanGoBack}" Value="True">
                                                            <Setter Property="Text" Value="Back to settings" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <ScrollViewer x:Name="AboutScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="36,28,36,36" MaxWidth="760" HorizontalAlignment="Left">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="DLSS5 Updater" Style="{StaticResource H1}" />
                                            <TextBlock Text="{Binding AppVersion}" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="10,0,0,3" />
                                            <TextBlock Text="{Binding PrivateBuildText}" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="10,0,0,3"
                                                       Visibility="{Binding IsPrivateBuild, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Button Style="{StaticResource BtnIcon}" Content="&#xE8BB;" HorizontalAlignment="Right" ToolTip="Close" AutomationProperties.Name="Close" Command="{Binding ToggleAboutCommand}" />
                                    </Grid>

                                    <TextBlock Text="USAGE" Style="{StaticResource SectionTitle}" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="21">
                                        <Run Foreground="{StaticResource Text}">Install / Update</Run> puts the ticked components next to the game's .exe and updates DLSS to the chosen version.<LineBreak />
                                        <Run Foreground="{StaticResource Text}">Update all</Run> re-applies everything after a new release or a game patch.<LineBreak />
                                        <Run Foreground="{StaticResource Text}">DLSS only</Run> updates the DLSS files and adds no mods (safe with anti-cheat).<LineBreak />
                                        <Run Foreground="{StaticResource Text}">Uninstall</Run> removes everything this app added and puts the original files back. <Run Foreground="{StaticResource Text}">Restore DLSS</Run> puts back only the original DLSS and Streamline files. Backups are in the game's .dlssupdater\backup folder.<LineBreak />
                                        Settings a game already has in OptiScaler.ini or ReShade.ini are kept on update when Existing configs is set to Keep game settings.
                                    </TextBlock>

                                    <TextBlock Text="GUIDE" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl x:Name="GuideList" ItemsSource="{Binding Guide}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GuideEntry}">
                                                <Border BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="14,10,0,10" Margin="0,0,0,2">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Topic.Title}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Topic.Group}" Style="{StaticResource Caps}" Foreground="{StaticResource Muted}"
                                                                       VerticalAlignment="Center" Margin="10,1,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Topic.Body}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" />
                                                        <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="2,0,0,0"
                                                                Padding="10,6" Margin="0,8,0,0" Visibility="{Binding Advice, Converter={StaticResource NullToVis}}">
                                                            <TextBlock TextWrapping="Wrap" LineHeight="19">
                                                                <Run Text="Which to pick: " Foreground="{StaticResource Accent}" FontWeight="SemiBold" /><Run Text="{Binding Advice, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                                            </TextBlock>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Choices}" Margin="0,6,0,0" Visibility="{Binding HasChoices, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:OptionChoice}">
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="170" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="12.5" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="PROJECTS" Style="{StaticResource SectionTitle}" />
                                    <Border Style="{StaticResource Card}" Padding="16,4">
                                        <ItemsControl>
                                            <ItemsControl.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0,9" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Command" Value="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Setter Property="CommandParameter" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <Grid Width="660">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="210" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding [0]}" Foreground="{StaticResource Text}" FontWeight="SemiBold" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding [1]}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Text="&#xE8A7;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ItemsControl.Resources>
                                            <Button Tag="https://github.com/ShyVortex/OptiScaler-DLSSNR-PreSR-Multipass">
                                                <x:Array Type="sys:String"><sys:String>OptiScaler-NR</sys:String><sys:String>ShyVortex · maintained DLSSNR fork of OptiScaler</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://github.com/optiscaler/OptiScaler">
                                                <x:Array Type="sys:String"><sys:String>OptiScaler</sys:String><sys:String>Upstream project and wiki</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://github.com/mavismmg/MFGAdaUnlock-RenoDx">
                                                <x:Array Type="sys:String"><sys:String>MFG Unlock</sys:String><sys:String>mavismmg · RTX 40 multi frame generation add-on</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://github.com/NVIDIA/DLSS">
                                                <x:Array Type="sys:String"><sys:String>NVIDIA DLSS</sys:String><sys:String>SR, RR and FG runtime DLLs</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://github.com/NVIDIA-RTX/Streamline">
                                                <x:Array Type="sys:String"><sys:String>NVIDIA Streamline</sys:String><sys:String>sl.*.dll runtime used for DLSS FG</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://reshade.me">
                                                <x:Array Type="sys:String"><sys:String>ReShade</sys:String><sys:String>crosire · use the full add-on build</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://github.com/clshortfuse/renodx">
                                                <x:Array Type="sys:String"><sys:String>RenoDX</sys:String><sys:String>ShortFuse · ReShade add-on framework (renodx-dlss.addon64 is imported)</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://github.com/clshortfuse/openNR">
                                                <x:Array Type="sys:String"><sys:String>ShortFuse NR compat</sys:String><sys:String>openNR · user-supplied RTX 20/30/40 runtime</sys:String></x:Array>
                                            </Button>
                                            <Button Tag="https://github.com/ApolloF/dlss5updater">
                                                <x:Array Type="sys:String"><sys:String>DLSS5 Updater</sys:String><sys:String>This app · source and releases</sys:String></x:Array>
                                            </Button>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock Text="Data, cache and log: %LocalAppData%\DLSS5Updater" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,16,0,0" />
                                    <TextBlock Text="Not affiliated with or endorsed by NVIDIA. NVIDIA and DLSS are trademarks of NVIDIA Corporation, used here only to describe compatibility." Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                            </DockPanel>
                        </DataTemplate>
                    </v:Deferred.Template>
                </v:Deferred>
            </Border>

        </Grid>

        <!-- ============ Log ============ -->
        <Border Grid.Row="3" Height="170" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Visibility="{Binding LogOpen, Converter={StaticResource BoolToVis}}">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="Transparent" BorderThickness="0" Padding="12,6"
                     Foreground="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- ============ Status bar ============ -->
        <Grid Grid.Row="4" Background="{StaticResource Surface}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" />
            <ProgressBar VerticalAlignment="Top" Value="{Binding Progress}" Maximum="1" IsIndeterminate="{Binding ProgressIndeterminate}"
                         Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Grid.Column="1" Text="{Binding LastLog}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="24,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource BtnGhost}" Padding="10,3" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource BtnGhost}" Padding="10,3" Command="{Binding ToggleLogCommand}" AutomationProperties.Name="{Binding LogButtonName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Log" FontSize="12" />
                            <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ First-run setup (over everything but the title bar) ============ -->
        <v:OnboardingView Grid.Row="1" Grid.RowSpan="4" DataContext="{Binding SettingsVm.Onboarding}"
                          Visibility="{Binding Converter={StaticResource NullToVis}}" />
    </Grid>
</Window>
